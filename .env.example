# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables.

# Required. SHA-256 of the API token derived from your vault key.
# Get it from the app: lock screen → Create a new vault, or Settings → Server setup.
VAULT_TOKEN_HASH=

# Postgres connection string. Vercel → Storage → Neon adds this automatically.
# Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Web Push (reminders and "list updated" notifications).
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, as a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# Upstash QStash (timed jobs). Leave empty locally: an in-process timer is used instead.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Protects the daily cleanup cron (Vercel sends it automatically) and local jobs.
# Any long random string, e.g. from: openssl rand -hex 32
CRON_SECRET=

# Public URL that QStash calls back. On Vercel, the production URL is used if unset.
# Locally: http://localhost:5173
APP_URL=

# Days to keep checked items before the daily cleanup removes them.
DONE_TTL_DAYS=7

# Origins allowed to call /api/sync from another site (the Übersicht Mac widget).
WIDGET_ORIGINS=http://127.0.0.1:41416
